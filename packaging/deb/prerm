#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "upgrade" ]; then
    # The resident tray app would linger as a broken ghost after its binary
    # and daemon are removed.
    pkill -f '^/usr/bin/frameguin' >/dev/null 2>&1 || true
    systemctl stop frameguin-daemon.service >/dev/null 2>&1 || true
fi
